---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A gift from Thorbjørn & [Name]' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Prevent search engines from indexing — this is a private gift site -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Qwitcher+Grypen&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --dark:   #0f0f1a;
      --cream:  #faf9f7;
      --text:   #2c2c2c;
      --muted:  #999;
      --border: #ddd8d0;
      --star:   rgba(255,255,255,0.85);
    }

    body {
      background: var(--dark);
      color: var(--text);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 16px;
      line-height: 1.7;
    }

    .display {
      font-family: 'Qwitcher Grypen', cursive;
      font-weight: 400;
    }
  </style>

  <body>
    <slot />
  </body>
</html>
